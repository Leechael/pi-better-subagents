{
  "name": "pi-better-subagents-eval",
  "private": true,
  "type": "module",
  "description": "E2E (faux model) and prompt-ablation (real model) evaluation for pi-better-subagents",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test:e2e": "node --test --test-concurrency=4 e2e/faux.test.ts",
    "test:tui": "PBS_E2E_TUI=1 node --test e2e/tui.test.ts",
    "test:unit": "node --test lib/wake-adapter.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
