{
  "name": "pi-famulus",
  "version": "0.1.0",
  "description": "Subagents, monitoring, and auto-backgrounding bash for pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leechael/pi-better-subagents",
    "directory": "extension"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "os": ["linux", "darwin"],
  "cpu": ["x64", "arm64"],
  "files": ["src", "bin", "README.md"],
  "bin": { "pi-famulus": "./bin/pi-famulus.js" },
  "optionalDependencies": {
    "pi-famulus-linux-x64": "0.1.0",
    "pi-famulus-linux-arm64": "0.1.0",
    "pi-famulus-darwin-x64": "0.1.0",
    "pi-famulus-darwin-arm64": "0.1.0"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
